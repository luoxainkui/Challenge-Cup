# 后端配置
APP_NAME=Challenge Cup Backend
APP_VERSION=0.1.0
DEBUG=true

# 数据库 - PostgreSQL (asyncpg)
# 本地开发: postgresql://postgres:postgres@localhost:5432/challenge_cup
# Docker 部署: postgresql://postgres:postgres@postgres:5432/challenge_cup
# 代码会自动添加 +asyncpg 协议前缀
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/challenge_cup

# JWT 安全（生产环境请使用随机生成的 256 位密钥）
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 允许的前端地址
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 服务端口
HOST=0.0.0.0
PORT=8000